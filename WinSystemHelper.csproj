<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>winsystemhelper-local-secrets</UserSecretsId>
    <Version>1.7.4</Version>
    <AssemblyVersion>1.7.4.0</AssemblyVersion>
    <FileVersion>1.7.4.0</FileVersion>
    <InformationalVersion>1.7.4</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WinSystemHelper.Bootstrapper\**;build-verify*\**;dist\**;publish\**;tests\**;artifacts\**" />
    <Content Remove="WinSystemHelper.Bootstrapper\**;build-verify*\**;dist\**;publish\**;tests\**;artifacts\**" />
    <EmbeddedResource Remove="WinSystemHelper.Bootstrapper\**;build-verify*\**;dist\**;publish\**;tests\**;artifacts\**" />
    <None Remove="WinSystemHelper.Bootstrapper\**;build-verify*\**;dist\**;publish\**;tests\**;artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Queue.Tests" />
    <EmbeddedResource Include="scripts\*.ps1" Exclude="scripts\Check-PublishSafety.ps1"
                      LogicalName="WinSystemHelper.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="Telegram.Bot" Version="22.9.6.1" />
  </ItemGroup>

</Project>
